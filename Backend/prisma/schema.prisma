// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  WEBSITE
  API
}

enum HealthStatus {
  UP
  DOWN
}

enum ActivityAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
}

enum ActivityEntity {
  DEVICE
  USER
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String @id @default(uuid())
  username     String @unique
  email        String @unique
  passwordHash String
  fullName     String
  role         Role   @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices                Device[]
  activityLogs           ActivityLog[]
  refreshTokens          RefreshToken[]
  notificationPreference NotificationPreference?
  notifications          Notification[]
  auditLogs              AuditLog[]
}

model Device {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  host String
  type DeviceType

  interval Int     @default(30) // Seconds
  enabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthLogs HealthLog[]
  incidents  Incident[]

  // Distributed Probes & Assignments
  selectedProbes  Json? // Array of probe IDs or regions e.g. ["probe-us-east", "probe-eu-west"]
  timeoutMs       Int               @default(10000)
  baselineLatency Float?
  assignments     CheckAssignment[]
  checkResults    CheckResult[]

  @@index([userId])
  @@index([host])
}

model HealthLog {
  id String @id @default(uuid())

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  status HealthStatus

  latency  Int?
  dnsTime  Int? @default(0)
  tcpTime  Int? @default(0)
  tlsTime  Int? @default(0)
  ttfbTime Int? @default(0)

  responseCode Int?

  message String?

  checkedAt DateTime @default(now())

  @@index([deviceId])
  @@index([checkedAt])
  @@index([deviceId, checkedAt])
}

model ActivityLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action ActivityAction

  entity ActivityEntity?

  entityId String?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Incident {
  id String @id @default(uuid())

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  type   String // "DOWNTIME", "LATENCY_SPIKE"
  status String // "OPEN", "INVESTIGATING", "ACTION_REQUIRED", "RECOVERING", "RESOLVED", "FAILED"

  error String? // "Connection timeout"

  priority       Severity @default(MEDIUM)
  priorityScore  Float    @default(0.0)
  priorityReason String?

  summary  String?
  timeline Json?

  // Multi-Probe Verification & Diagnostic Evidence
  assessment         String? // "WIDESPREAD_FAILURE", "LOCATION_SPECIFIC_FAILURE", "PROBE_CONNECTIVITY_SUSPECTED", "DNS_FAILURE", "TLS_CERTIFICATE_FAILURE", "LATENCY_DEGRADATION", "INSUFFICIENT_EVIDENCE"
  failedStage        String? // "DNS_RESOLUTION", "TCP_CONNECTION", "TLS_VERIFICATION", "HTTP_STATUS", "TIMEOUT", "UNKNOWN"
  affectedLocations  Json? // Array of region strings e.g. ["us-east-1"]
  supportingEvidence Json? // Structured probe verdicts & control results
  uncertainties      Json? // Documented unknowns / uncertainties
  acknowledgedAt     DateTime?
  acknowledgedBy     String?

  openedAt   DateTime  @default(now())
  resolvedAt DateTime?

  @@index([deviceId])
  @@index([status])
  @@index([priority])
}

model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifyAnomaly     Boolean  @default(true)
  notifyUnavailable Boolean  @default(true)
  notifyCritical    Boolean  @default(true)
  notifyRecovery    Boolean  @default(true)
  minSeverity       Severity @default(MEDIUM)
  email             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId   String?
  incidentId String?

  type     String // "ANOMALY", "INCIDENT", "RECOVERY", "INVESTIGATION"
  title    String
  message  String
  severity Severity @default(MEDIUM)
  isRead   Boolean  @default(false)

  sentAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([sentAt])
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String // Authentication and operational audit events
  entityType String
  entityId   String?
  details    Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id    String @id @default(uuid())
  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
}

model Probe {
  id              String    @id @default(uuid())
  name            String
  region          String // e.g. "us-east-1", "eu-central-1", "lab-probe-a"
  tokenHash       String    @unique
  status          String    @default("ONLINE") // "ONLINE", "OFFLINE", "REVOKED"
  isRevoked       Boolean   @default(false)
  version         String?   @default("1.0.0")
  lastHeartbeatAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignments  CheckAssignment[]
  checkResults CheckResult[]

  @@index([region])
  @@index([status])
}

model ControlEndpoint {
  id             String   @id @default(uuid())
  name           String
  url            String
  expectedStatus Int      @default(200)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CheckAssignment {
  id             String    @id @default(uuid())
  monitorId      String
  device         Device    @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  probeId        String
  probe          Probe     @relation(fields: [probeId], references: [id], onDelete: Cascade)
  kind           String    @default("ROUTINE") // "ROUTINE", "DIAGNOSTIC_CONFIRMATION", "CONTROL_CHECK"
  targetUrl      String
  status         String    @default("PENDING") // "PENDING", "LEASED", "COMPLETED", "EXPIRED"
  leasedAt       DateTime?
  leaseExpiresAt DateTime?
  attemptCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  result CheckResult?

  @@index([probeId, status])
  @@index([status, leaseExpiresAt])
  @@index([monitorId])
}

model CheckResult {
  id           String           @id @default(uuid())
  kind         String           @default("ROUTINE") // Snapshot of assignment kind; separates control from target evidence
  assignmentId String?          @unique
  assignment   CheckAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  monitorId    String
  device       Device           @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  probeId      String
  probe        Probe            @relation(fields: [probeId], references: [id], onDelete: Cascade)
  status       HealthStatus // UP, DOWN
  latency      Int? // Total latency ms
  dnsTime      Int?             @default(0)
  tcpTime      Int?             @default(0)
  tlsTime      Int?             @default(0)
  ttfbTime     Int?             @default(0)
  responseCode Int?
  failureStage String? // "DNS_RESOLUTION", "TCP_CONNECTION", "TLS_VERIFICATION", "HTTP_STATUS", "TIMEOUT", "SSRF_BLOCKED"
  message      String?
  resolvedIp   String?
  tlsCert      Json? // { issuer, subject, validTo, daysRemaining, authorized }
  isLate       Boolean          @default(false)
  observedAt   DateTime         @default(now())
  receivedAt   DateTime         @default(now())

  @@index([monitorId, observedAt])
  @@index([probeId, observedAt])
  @@index([status])
}
