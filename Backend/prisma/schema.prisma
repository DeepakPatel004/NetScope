// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  WEBSITE
  API
  IP
  SERVER
  WORKER
}

enum HealthStatus {
  UP
  DOWN
}

enum ActivityAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
}

enum ActivityEntity {
  DEVICE
  USER
  AGENT
  RECOVERY
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(USER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices                 Device[]
  activityLogs            ActivityLog[]
  refreshTokens           RefreshToken[]
  notificationPreference NotificationPreference?
  notifications           Notification[]
  auditLogs               AuditLog[]
}

model Device {
  id        String     @id @default(uuid())

  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  host      String
  type      DeviceType

  interval  Int        @default(1)
  enabled   Boolean    @default(true)

  // NetScope Agent Authentication & Host Status
  agentKey      String?   @unique
  agentStatus   String    @default("NOT_CONNECTED") // "NOT_CONNECTED", "ONLINE", "OFFLINE"
  lastSeen      DateTime?
  metricsSource String    @default("EXTERNAL_HTTP") // "EXTERNAL_HTTP", "NETSCOPE_AGENT"

  // Environment & Container Discovery
  dockerStatus          String?   @default("NOT_INSTALLED") // "NOT_INSTALLED", "AVAILABLE", "RUNNING"
  containers            Json?     // Array of discovered containers [{ id, name, image, status, ports, created }]
  dockerComposeProjects Json?     // Array of discovered Docker Compose projects
  capabilities          Json?     // Discovered capabilities ["restart_container", "restart_compose_service"]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  healthLogs      HealthLog[]
  sslLogs         SSLStatus[]
  portScanLogs    PortScanLog[]
  incidents       Incident[]
  anomalies       Anomaly[]
  agentMetrics    AgentMetric[]
  recoveryActions RecoveryAction[]

  @@index([userId])
  @@index([host])
  @@index([agentKey])
}

model HealthLog {
  id            String        @id @default(uuid())

  deviceId       String
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  status         HealthStatus

  latency        Int?
  dnsTime        Int?          @default(0)
  tcpTime        Int?          @default(0)
  tlsTime        Int?          @default(0)
  ttfbTime       Int?          @default(0)

  responseCode   Int?

  message        String?

  checkedAt      DateTime      @default(now())

  @@index([deviceId])
  @@index([checkedAt])
  @@index([deviceId, checkedAt])
}

model AgentMetric {
  id            String   @id @default(uuid())

  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  cpuPercent    Float?
  ramPercent    Float?
  ramUsedMb     Float?
  ramTotalMb    Float?
  diskPercent   Float?
  diskUsedGb    Float?
  diskTotalGb   Float?
  loadAvg       Float?
  netBytesSent  Float?
  netBytesRecv  Float?

  checkedAt     DateTime @default(now())

  @@index([deviceId])
  @@index([checkedAt])
  @@index([deviceId, checkedAt])
}

model ActivityLog {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action     ActivityAction

  entity     ActivityEntity?

  entityId   String?

  createdAt  DateTime @default(now())

  @@index([userId])
}

enum CertificateStatus {
  VALID
  EXPIRING
  EXPIRED
  INVALID
}

model SSLStatus {
  id            String            @id @default(uuid())

  deviceId      String
  device        Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  issuer        String?
  subject       String?
  validFrom     DateTime?
  validTo       DateTime?
  daysRemaining Int?
  serialNumber  String?
  fingerprint   String?

  status        CertificateStatus

  checkedAt     DateTime          @default(now())

  @@index([deviceId])
  @@index([checkedAt])
  @@index([deviceId, checkedAt])
}

model PortScanLog {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  openPorts   Int[]
  checkedAt   DateTime @default(now())

  @@index([deviceId])
  @@index([checkedAt])
  @@index([deviceId, checkedAt])
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Anomaly {
  id              String      @id @default(uuid())

  deviceId        String
  device          Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  timestamp       DateTime    @default(now())
  anomalyScore    Float
  severity        Severity
  detectionReason String
  metrics         Json

  isResolved      Boolean     @default(false)
  resolvedAt      DateTime?

  incidents       Incident[]

  @@index([deviceId])
  @@index([timestamp])
  @@index([deviceId, timestamp])
  @@index([severity])
}

model Incident {
  id                 String      @id @default(uuid())

  deviceId           String
  device             Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  type               String      // "DOWNTIME", "ANOMALY", "LATENCY_SPIKE", "HIGH_CPU", "HIGH_RAM", "SERVER_OFFLINE"
  status             String      // "OPEN", "INVESTIGATING", "ACTION_REQUIRED", "RECOVERING", "RESOLVED", "FAILED"
  
  error              String?     // "Connection timeout"
  currentValue       String?
  expectedValue      String?
  
  priority           Severity    @default(MEDIUM)
  priorityScore      Float       @default(0.0)
  priorityReason     String?
  
  riskLevel              String?  @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  businessImpact         String?  // Impact analysis statement
  recoveryRecommendation String?  // AI Recommended action details

  summary            String?
  possibleCauses     Json?
  recommendedActions Json?
  evidence           Json?
  confidence         Float?
  timeline           Json?

  anomalyId          String?
  anomaly            Anomaly?    @relation(fields: [anomalyId], references: [id], onDelete: SetNull)

  openedAt           DateTime    @default(now())
  investigatedAt     DateTime?
  resolvedAt         DateTime?   

  recoveryActions    RecoveryAction[]

  @@index([deviceId])
  @@index([status])
  @@index([priority])
}

model NotificationPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifyAnomaly     Boolean  @default(true)
  notifyUnavailable Boolean  @default(true)
  notifyCritical    Boolean  @default(true)
  minSeverity       Severity @default(MEDIUM)
  email             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId    String?
  incidentId  String?

  type        String   // "ANOMALY", "INCIDENT", "RECOVERY", "INVESTIGATION"
  title       String
  message     String
  severity    Severity @default(MEDIUM)
  isRead      Boolean  @default(false)

  sentAt      DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([sentAt])
}

model RecoveryAction {
  id                 String    @id @default(uuid())

  incidentId         String?
  incident           Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  deviceId           String
  device             Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  actionType         String    // "restart_container", "restart_compose_service"
  targetName         String    // container ID, container name, or compose service name
  provider           String    @default("DOCKER") // "DOCKER", "DOCKER_COMPOSE"
  riskLevel          String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status             String    // "RECOMMENDED", "PENDING_APPROVAL", "APPROVED", "EXECUTING", "VERIFYING", "SUCCESS", "FAILED"

  reason             String?
  cliCommand         String?
  requiresApproval   Boolean   @default(true)

  approvedById       String?
  approvedAt         DateTime?
  executedAt         DateTime?
  completedAt        DateTime?
  executionResult    String?
  verificationResult String?
  errorMessage       String?

  createdAt          DateTime  @default(now())

  @@index([incidentId])
  @@index([deviceId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(uuid())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      String   // "AI_INVESTIGATION", "RECOVERY_APPROVED", "RECOVERY_EXECUTED", "RECOVERY_VERIFIED", "NOTIFICATION_SENT", "INCIDENT_RESOLVED"
  entityType  String
  entityId    String?
  details     Json?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id           String   @id @default(uuid())
  token        String   @unique

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revoked      Boolean  @default(false)

  @@index([userId])
}