// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  WEBSITE
  API
  IP
}

enum HealthStatus {
  UP
  DOWN
}

enum ActivityAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
}

enum ActivityEntity {
  DEVICE
  USER
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(USER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices       Device[]
  activityLogs  ActivityLog[]
  refreshTokens RefreshToken[]
}

model Device {
  id        String     @id @default(uuid())

  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  host      String
  type      DeviceType

  interval  Int        @default(1)
  enabled   Boolean    @default(true)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  healthLogs HealthLog[]
  sslLogs   SSLStatus[]
  portScanLogs PortScanLog[]
  incidents Incident[]
  anomalies Anomaly[]

  @@index([userId])
  @@index([host])
}

model HealthLog {
  id            String        @id @default(uuid())

  deviceId       String
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  status         HealthStatus

  latency        Int?
  dnsTime        Int?          @default(0)
  tcpTime        Int?          @default(0)
  tlsTime        Int?          @default(0)
  ttfbTime       Int?          @default(0)

  responseCode   Int?

  message        String?

  checkedAt      DateTime      @default(now())

  @@index([deviceId])
  @@index([checkedAt])
  @@index([deviceId, checkedAt])
}

model ActivityLog {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action ActivityAction

  entity ActivityEntity?

  entityId    String?

  createdAt  DateTime @default(now())

  @@index([userId])
}

enum CertificateStatus {
  VALID
  EXPIRING
  EXPIRED
  INVALID
}

model SSLStatus {
  id            String            @id @default(uuid())

  deviceId      String
  device        Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  issuer        String?
  subject       String?
  validFrom     DateTime?
  validTo       DateTime?
  daysRemaining Int?
  serialNumber  String?
  fingerprint   String?

  status        CertificateStatus

  checkedAt     DateTime          @default(now())

  @@index([deviceId])
  @@index([checkedAt])
  @@index([deviceId, checkedAt])
}

model PortScanLog {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  openPorts   Int[]
  checkedAt   DateTime @default(now())

  @@index([deviceId])
  @@index([checkedAt])
  @@index([deviceId, checkedAt])
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Anomaly {
  id              String      @id @default(uuid())

  deviceId        String
  device          Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  timestamp       DateTime    @default(now())
  anomalyScore    Float
  severity        Severity
  detectionReason String
  metrics         Json

  isResolved      Boolean     @default(false)
  resolvedAt      DateTime?

  incidents       Incident[]

  @@index([deviceId])
  @@index([timestamp])
  @@index([deviceId, timestamp])
  @@index([severity])
}

model Incident {
  id                 String      @id @default(uuid())

  deviceId           String
  device             Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  type               String      // "DOWNTIME", "ANOMALY", "LATENCY_SPIKE"
  status             String      // "OPEN" or "RESOLVED"
  
  error              String?     // "Connection timeout"
  
  priority           Severity    @default(MEDIUM)
  priorityScore      Float       @default(0.0)
  priorityReason     String?
  
  summary            String?
  possibleCauses     Json?
  recommendedActions Json?
  confidence         Float?
  timeline           Json?

  anomalyId          String?
  anomaly            Anomaly?    @relation(fields: [anomalyId], references: [id], onDelete: SetNull)

  openedAt           DateTime    @default(now())
  resolvedAt         DateTime?   

  @@index([deviceId])
  @@index([status])
  @@index([priority])
}

model RefreshToken {
  id           String   @id @default(uuid())
  token        String   @unique

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revoked      Boolean  @default(false)

  @@index([userId])
}